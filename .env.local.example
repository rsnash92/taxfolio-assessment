# =============================================================================
# TaxFolio Assessment App - Environment Configuration
# =============================================================================
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase (Required)
# Get these from your Supabase project settings
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# -----------------------------------------------------------------------------
# HMRC Transaction Engine (Required for submissions)
# Register at: https://www.gov.uk/government/organisations/hm-revenue-customs/contact/hmrc-it-software-developers
# -----------------------------------------------------------------------------
HMRC_VENDOR_ID=your-vendor-id
HMRC_SENDER_ID=your-sender-id
HMRC_SENDER_PASSWORD=your-sender-password

# Transaction Engine URL
# Test: https://test-transaction-engine.tax.service.gov.uk
# Production: https://transaction-engine.tax.service.gov.uk
HMRC_TRANSACTION_ENGINE_URL=https://test-transaction-engine.tax.service.gov.uk

# -----------------------------------------------------------------------------
# TrueLayer Open Banking (Optional - for transaction import)
# Register at: https://truelayer.com/
# -----------------------------------------------------------------------------
TRUELAYER_CLIENT_ID=your-client-id
TRUELAYER_CLIENT_SECRET=your-client-secret
TRUELAYER_REDIRECT_URI=http://localhost:3000/api/truelayer/callback
NEXT_PUBLIC_TRUELAYER_ENVIRONMENT=sandbox

# -----------------------------------------------------------------------------
# Anthropic AI (Optional - for AI categorization)
# Get from: https://console.anthropic.com/
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=your-anthropic-key

# -----------------------------------------------------------------------------
# Cloudflare Turnstile (Optional - for bot protection)
# Get from: https://dash.cloudflare.com/
# -----------------------------------------------------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-site-key
TURNSTILE_SECRET_KEY=your-secret-key

# -----------------------------------------------------------------------------
# Google Analytics (Optional)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# -----------------------------------------------------------------------------
# Environment
# -----------------------------------------------------------------------------
NODE_ENV=development
